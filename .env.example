# ─────────────────────────────────────────────────────────────────────────────
# Juriq Root .env.example
# Full-stack environment variable template for local development.
# Copy this to .env (root) or configure each app's .env separately.
# NEVER commit real values. Use your secret manager in production.
# ─────────────────────────────────────────────────────────────────────────────

# ── Shared ────────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Backend (apps/backend or backend/) ────────────────────────────────────────
PORT=5000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=debug

# MongoDB Atlas Connection String (REQUIRED)
# Get from: https://cloud.mongodb.com/ → Connect → Drivers → Node.js
MONGODB_URI=mongodb+srv://your-username:your-password@cluster0.xxxxx.mongodb.net/juriq?retryWrites=true&w=majority

# JWT Secrets (REQUIRED — minimum 64 chars, generate with openssl rand -hex 64)
JWT_SECRET=your-jwt-secret-minimum-64-characters-generate-with-openssl-rand-hex-64
JWT_REFRESH_SECRET=your-jwt-refresh-secret-different-from-jwt-secret-also-64-chars

# Cloudinary (REQUIRED for document uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key-number
CLOUDINARY_API_SECRET=your-api-secret

# Redis (optional — in-memory fallback activates if not set)
# For local dev: redis://localhost:6379
# For production: Use Redis Cloud, Upstash, or Railway Redis
REDIS_URL=redis://localhost:6379

# Frontend URL (for CORS + email reset links)
FRONTEND_URL=http://localhost:5173

# ── Email / SMTP (REQUIRED for password reset + notifications) ─────────────────
# Hostinger: smtp.hostinger.com | Gmail: smtp.gmail.com | Zoho: smtp.zoho.com
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contact@juriq.in
SMTP_PASS=your-smtp-password-here
MAIL_FROM=contact@juriq.in

# Password reset email base URL (no trailing slash)
RESET_PASSWORD_BASE_URL=https://juriq.in

# ── Google OAuth (optional — leave empty to disable Google login) ──────────────
# Setup: https://console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID
# Authorised redirect URI: http://localhost:5000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ── Razorpay Payments (REQUIRED for subscription billing) ─────────────────────
# Test keys: https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ── Sentry (optional — error monitoring) ──────────────────────────────────────
# SENTRY_DSN=https://xxxxxxxxxxxx@o0000000.ingest.sentry.io/0000000

# ── Frontend (apps/frontend or frontend/) ─────────────────────────────────────
# Vite env vars must be prefixed with VITE_
VITE_API_URL=http://localhost:5000
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
# VITE_SENTRY_DSN=https://xxxxxxxxxxxx@o0000000.ingest.sentry.io/0000000

# ── Docker Compose overrides ──────────────────────────────────────────────────
# When running with docker-compose, these can be overridden:
# MONGO_ROOT_USER=juriq_admin
# MONGO_ROOT_PASS=change_this_password
# REDIS_MAXMEMORY=256mb
