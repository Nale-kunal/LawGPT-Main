{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "type-enum": [
      2,
      "always",
      [
        "feat",
        "fix",
        "docs",
        "style",
        "refactor",
        "perf",
        "test",
        "build",
        "ci",
        "chore",
        "revert",
        "security",
        "deps"
      ]
    ],
    "scope-enum": [
      1,
      "always",
      [
        "backend",
        "frontend",
        "workers",
        "shared-types",
        "shared-utils",
        "eslint-config",
        "tsconfig",
        "docs",
        "ci",
        "docker",
        "infra",
        "deps",
        "release"
      ]
    ],
    "subject-case": [2, "always", "lower-case"],
    "subject-full-stop": [2, "never", "."],
    "header-max-length": [2, "always", 100],
    "body-max-line-length": [1, "always", 120],
    "footer-max-line-length": [1, "always", 120]
  }
}
