{
  "name": "juriq",
  "private": true,
  "version": "1.0.0",
  "description": "Juriq — Enterprise Legal Practice Management SaaS for Indian Lawyers",
  "keywords": [
    "legal-tech",
    "saas",
    "practice-management",
    "india",
    "lawyers"
  ],
  "homepage": "https://juriq.in",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nale-kunal/juriq"
  },
  "license": "MIT",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "backend",
    "frontend",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "dev:workers": "npm run workers -w backend",
    "build": "turbo run build",
    "build:frontend": "npm run build -w frontend",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test",
    "test:backend": "npm run test -w backend",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .gitignore",
    "prepare": "node -e \"if(process.env.CI !== 'true') require('child_process').execSync('husky', {stdio:'inherit'})\" || true",
    "clean": "turbo run clean && rm -rf node_modules",
    "workspace:list": "npm query .workspace",
    "audit:all": "npm audit --workspaces",
    "seed:legal": "npm run seed:legal -w backend",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:build": "docker compose build"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.5.0",
    "turbo": "^2.5.0",
    "ws": "8.21.0",
    "js-yaml": "4.2.0",
    "uuid": "11.1.1"
  },
  "overrides": {
    "minimatch": "^10.2.3",
    "glob": ">=10.5.1",
    "qs": ">=6.15.0",
    "eslint": {
      "ajv": ">=6.14.0 <7.0.0"
    },
    "rollup": "^4.34.8",
    "lodash": ">=4.17.22",
    "form-data": "^4.0.6",
    "ws": "8.21.0",
    "js-yaml": "4.2.0",
    "uuid": "11.1.1"
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --config frontend/eslint.config.js --max-warnings=0 --fix"
    ],
    "frontend/**/*.{js,jsx}": [
      "prettier --write",
      "eslint --config frontend/eslint.config.js --max-warnings=0 --fix"
    ],
    "backend/**/*.{js,jsx}": [
      "prettier --write",
      "eslint --config backend/eslint.config.js --max-warnings=150 --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "turbo": {
    "extends": [
      "//"
    ]
  }
}
