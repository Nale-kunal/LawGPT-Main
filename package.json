{
  "name": "juriq",
  "private": true,
  "version": "1.0.0",
  "description": "Juriq — Enterprise Legal Practice Management SaaS for Indian Lawyers",
  "keywords": ["legal-tech", "saas", "practice-management", "india", "lawyers"],
  "homepage": "https://juriq.in",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nale-kunal/juriq"
  },
  "license": "MIT",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:workers": "pnpm --filter backend workers",
    "build": "turbo run build",
    "build:frontend": "pnpm --filter frontend build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test",
    "test:backend": "pnpm --filter backend test",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .gitignore",
    "prepare": "node -e \"if(process.env.CI !== 'true') require('child_process').execSync('husky', {stdio:'inherit'})\" || true",
    "clean": "turbo run clean && rm -rf node_modules",
    "workspace:list": "pnpm list --recursive --depth=0",
    "audit:all": "pnpm audit --recursive",
    "seed:legal": "pnpm --filter backend seed:legal",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:build": "docker compose build"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.5.0",
    "turbo": "^2.5.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --max-warnings=0 --fix"
    ],
    "*.{js,jsx}": [
      "prettier --write",
      "eslint --max-warnings=0 --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "turbo": {
    "extends": ["//"]
  }
}
